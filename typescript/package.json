{
  "name": "@eigenscope/integration-lab",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "TypeScript reference integration and SDK protocol-boundary tests",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "live": "node examples/live.ts",
    "format": "prettier --write . ../src/eigenscope_lab/assets/web",
    "format:check": "prettier --check . ../src/eigenscope_lab/assets/web"
  },
  "dependencies": {
    "@eigenscope/sdk": "https://github.com/LuckyOkoedion/eigenscope-integration-lab/releases/download/sdk-typescript-0.2.2-80b9beda/eigenscope-sdk-0.2.2.tgz"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  }
}
